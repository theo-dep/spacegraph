{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg",
            "configuration": "Release"
        },
        {
            "name": "vcpkg-debug",
            "configurePreset": "vcpkg",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "vcpkg",
            "configurePreset": "vcpkg",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}